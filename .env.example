# API Configuration
# When using nginx proxy (Docker/Coolify): /api
# For local Vite dev server with backend proxy: /api (default)
# For direct backend access (bypassing proxy): http://localhost:5080/api
VITE_API_URL=/api

# Optional: Direct backend URL (for debugging, not typically needed)
# VITE_BACKEND_URL=http://localhost:5080

# Debug Logging (optional)
# Enable debug output in browser console
# VITE_DEBUG=true
# VITE_DEBUG_LEVEL=verbose
# VITE_DEBUG_MODULES=auth,api
