{
  "name": "fc-frontend",
  "version": "3.2.1",
  "private": true,
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.9",
    "@chakra-ui/utils": "^2.2.5",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@types/dompurify": "^3.0.5",
    "axios": "^1.13.5",
    "dompurify": "^3.3.1",
    "framer-motion": "^12.23.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.65.0",
    "react-icons": "^4.11.0",
    "react-markdown": "^10.1.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.30.3",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.8"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "lint": "echo 'Using eslint via react-scripts'",
    "test": "react-scripts test --coverage --watchAll=false --verbose --testPathIgnorePatterns='cross-service'",
    "test:unit": "react-scripts test --watchAll=false --verbose --testPathIgnorePatterns='cross-service|integration'",
    "test:integration": "react-scripts test --watchAll=false --verbose --testPathPattern='integration' --testPathIgnorePatterns='cross-service'",
    "test:e2e": "react-scripts test --watchAll=false --verbose --testPathPattern='cross-service'",
    "test:watch": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false --testPathIgnorePatterns='cross-service'",
    "test:ci": "CI=true react-scripts test --coverage --watchAll=false --maxWorkers=2 --testPathIgnorePatterns='cross-service'",
    "test:a11y": "react-scripts test --testNamePattern='accessibility' --watchAll=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "@chakra-ui/utils/context": "<rootDir>/node_modules/@chakra-ui/utils/dist/cjs/context.cjs"
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.{ts,tsx}",
      "<rootDir>/src/**/*.spec.{ts,tsx}"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "serialize-javascript": ">=7.0.3",
    "postcss": "^8.4.31",
    "qs": "^6.14.1",
    "webpack-dev-server": "^5.2.2",
    "bfj": "^9.1.3",
    "lodash": "^4.17.23",
    "webpack": "^5.105.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@craco/craco": "^7.1.0",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/cache": "^11.14.0",
    "@emotion/jest": "^11.13.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.5",
    "@types/jest-axe": "^3.5.6",
    "@types/node": "^16.18.50",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "babel-jest": "^30.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "http-proxy-middleware": "^3.0.5",
    "identity-obj-proxy": "^3.0.0",
    "jest-axe": "^10.0.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^16.0.0",
    "jest-pnp-resolver": "^1.2.3",
    "jest-transform-css": "^6.0.3",
    "react-scripts": "^5.0.1",
    "regenerator-runtime": "^0.14.1",
    "typescript": "^4.9.5"
  }
}
