{
  "name": "fc-frontend",
  "version": "3.2.3",
  "private": true,
  "type": "module",
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@simplewebauthn/browser": "^13.2.2",
    "axios": "^1.20.0",
    "dompurify": "^3.4.14",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.87.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-query": "^3.39.3",
    "react-router": "^7.18.3",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/prerender-meta.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs --coverage --watchAll=false --verbose --testPathIgnorePatterns='cross-service'",
    "test:unit": "jest --config jest.config.cjs --watchAll=false --verbose --testPathIgnorePatterns='cross-service|integration'",
    "test:integration": "jest --config jest.config.cjs --watchAll=false --verbose --testPathPatterns='integration' --testPathIgnorePatterns='cross-service'",
    "test:e2e": "jest --config jest.config.cjs --watchAll=false --verbose --testPathPatterns='cross-service'",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage --watchAll=false --testPathIgnorePatterns='cross-service'",
    "test:ci": "CI=true jest --config jest.config.cjs --coverage --watchAll=false --maxWorkers=2 --testPathIgnorePatterns='cross-service'",
    "test:a11y": "jest --config jest.config.cjs --testNamePattern='accessibility' --watchAll=false"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "nwsapi": "2.2.24",
    "nth-check": "^2.1.1",
    "serialize-javascript": ">=7.0.3",
    "postcss": "^8.5.26",
    "qs": "^6.14.1",
    "lodash": "^4.18.1",
    "brace-expansion@1": "1.1.18",
    "nanoid@3": "3.3.18",
    "js-yaml@3": "3.15.1"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.1",
    "babel-preset-react-app": "^10.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.1",
    "jest-junit": "^17.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
